rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function configPath() {
      return /databases/$(database)/documents/system/device-access;
    }

    function currentDevice() {
      return get(/databases/$(database)/documents/system/device-access/devices/$(currentUid())).data;
    }

    function activeDevice() {
      return signedIn()
        && exists(/databases/$(database)/documents/system/device-access/devices/$(currentUid()))
        && currentDevice().active == true;
    }

    function memberDevice() {
      return activeDevice()
        && (currentDevice().role == 'member' || currentDevice().role == 'control');
    }

    function validRole(value) {
      return value == 'member'
        || value == 'reception'
        || value == 'control';
    }

    function shortText(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 120;
    }

    function validDevice(data) {
      return data.keys().hasOnly([
          'role', 'displayName', 'deviceName', 'deviceType', 'active',
          'createdAt', 'approvedAt', 'approvedByUid', 'approvedByName'
        ])
        && data.keys().hasAll([
          'role', 'displayName', 'deviceName', 'deviceType', 'active',
          'createdAt', 'approvedAt', 'approvedByUid', 'approvedByName'
        ])
        && validRole(data.role)
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && data.deviceType is string
        && data.active is bool
        && data.createdAt is timestamp
        && data.approvedAt is timestamp
        && data.approvedByUid is string
        && data.approvedByName is string;
    }

    function validRequestType(value) {
      return value == 'initial' || value == 'upgrade';
    }

    function validRequestStatus(value) {
      return value == 'pending' || value == 'approved' || value == 'rejected';
    }

    function validRequest(data) {
      return data.keys().hasOnly([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid', 'decidedByName',
          'pairingCode', 'pairingExpiresAt'
        ])
        && data.keys().hasAll([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid', 'decidedByName'
        ])
        && validRequestType(data.requestType)
        && validRole(data.requestedRole)
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && data.deviceType is string
        && data.status == 'pending'
        && data.requestedAt == request.time
        && data.decidedAt == null
        && data.decidedByUid == ''
        && data.decidedByName == ''
        && (!('pairingCode' in data) || data.pairingCode is string)
        && (!('pairingExpiresAt' in data) || data.pairingExpiresAt is timestamp);
    }

    function validAudit(data) {
      return data.keys().hasOnly([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.keys().hasAll([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.action in [
          'bootstrap-member', 'request-created', 'request-approved',
          'request-rejected', 'device-disabled', 'device-renamed',
          'device-deleted'
        ]
        && data.actorUid is string
        && shortText(data.actorName)
        && data.targetUid is string
        && shortText(data.targetName)
        && (data.role == null || validRole(data.role))
        && data.createdAt == request.time;
    }

    function validReceptionStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastReceptionAt', 'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberCreate(memberId) {
      return request.resource.data.keys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberUpdate(memberId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validScannerActivity(activityId) {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'qrNumber', 'timestamp', 'isReEntry', 'source',
          'offline', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'type', 'qrNumber', 'timestamp', 'source', 'createdAt'
        ])
        && request.resource.data.id == activityId
        && request.resource.data.type in [
          'ticket-entry', 'ticket-exit', 'member-entry', 'member-exit'
        ]
        && request.resource.data.qrNumber is string
        && request.resource.data.timestamp is string
        && request.resource.data.source == 'scanner'
        && (!('isReEntry' in request.resource.data)
          || request.resource.data.isReEntry is bool)
        && (!('offline' in request.resource.data)
          || request.resource.data.offline is bool)
        && request.resource.data.createdAt == request.time;
    }

    function validAnalyticsSummary(summaryId) {
      return summaryId == 'summary'
        && request.resource.data.schemaVersion == 2
        && (request.resource.data.revision is int
          || request.resource.data.revision is float)
        && request.resource.data.revision >= 0
        && request.resource.data.needsRebuild is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionPresence(deviceId) {
      return request.resource.data.keys().hasOnly([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'receptionPaused', 'firebaseLatencyMs',
          'downloadMbps', 'networkMeasuredAt', 'screen', 'viewState', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'screen', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.registeredDeviceId == currentUid()
        && request.resource.data.deviceName == currentDevice().deviceName
        && (!('deviceType' in currentDevice()) || request.resource.data.deviceType == currentDevice().deviceType)
        && request.resource.data.role == currentDevice().role
        && request.resource.data.mode in ['entry', 'exit']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() > 0
        && request.resource.data.appVersion.size() <= 20
        && (request.resource.data.lastSeenAt is int || request.resource.data.lastSeenAt is float)
        && request.resource.data.lastSuccessfulSyncAt == request.time
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 0
        && request.resource.data.cameraState in ['starting', 'ready', 'error']
        && (!('receptionPaused' in request.resource.data) || request.resource.data.receptionPaused is bool)
        && (!('firebaseLatencyMs' in request.resource.data) || (request.resource.data.firebaseLatencyMs is int && request.resource.data.firebaseLatencyMs >= 0 && request.resource.data.firebaseLatencyMs <= 120000))
        && (!('downloadMbps' in request.resource.data) || (((request.resource.data.downloadMbps is int || request.resource.data.downloadMbps is float) && request.resource.data.downloadMbps >= 0 && request.resource.data.downloadMbps <= 10000)))
        && (!('networkMeasuredAt' in request.resource.data) || (request.resource.data.networkMeasuredAt is string && request.resource.data.networkMeasuredAt.size() <= 60))
        && request.resource.data.screen in ['entry-reception', 'exit-reception']
        && (!('viewState' in request.resource.data) || request.resource.data.viewState in ['waiting', 'processing', 'success-animation', 'ticket-success', 'member-success', 'error'])
        && request.resource.data.sessionStartedAt is string
        && request.resource.data.sessionStartedAt.size() <= 60
        && request.resource.data.lastScanAt is string
        && request.resource.data.lastScanAt.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    function validRemoteCommandType(value) {
      return value in ['pause-reception', 'resume-reception', 'restart-camera', 'sync-pending', 'play-sound', 'reload-app'];
    }

    function validRemoteCommandCreate(data) {
      return data.keys().hasOnly([
          'type', 'status', 'issuedByUid', 'issuedByName', 'createdAt',
          'expiresAt', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && data.keys().hasAll([
          'type', 'status', 'issuedByUid', 'issuedByName', 'createdAt',
          'expiresAt', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && validRemoteCommandType(data.type)
        && data.status == 'pending'
        && data.issuedByUid == currentUid()
        && shortText(data.issuedByName)
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(1, 'm')
        && data.receivedAt == null
        && data.completedAt == null
        && data.updatedAt == request.time
        && data.errorMessage == '';
    }

    function ownsReceptionPresence(eventId, deviceId) {
      return activeDevice()
        && exists(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId))
        && get(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId)).data.registeredDeviceId == currentUid();
    }

    function validRemoteCommandUpdate(data) {
      return data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'receivedAt', 'completedAt', 'updatedAt', 'errorMessage'
        ])
        && data.type == resource.data.type
        && data.issuedByUid == resource.data.issuedByUid
        && data.issuedByName == resource.data.issuedByName
        && data.createdAt == resource.data.createdAt
        && data.expiresAt == resource.data.expiresAt
        && data.updatedAt == request.time
        && data.errorMessage is string
        && data.errorMessage.size() <= 160
        && ((resource.data.status == 'pending' && data.status == 'received' && data.receivedAt == request.time && data.completedAt == null && data.errorMessage == '')
          || (resource.data.status == 'pending' && data.status == 'failed' && data.receivedAt == null && data.completedAt == request.time)
          || (resource.data.status == 'received' && data.status in ['completed', 'failed'] && data.receivedAt == resource.data.receivedAt && data.completedAt == request.time));
    }

    match /authorized-users/{document=**} {
      allow read, write: if false;
    }

    match /system/device-access {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['initialized', 'memberDeviceCount', 'createdAt', 'updatedAt'])
        && request.resource.data.initialized == true
        && request.resource.data.memberDeviceCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
          memberDevice()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberDeviceCount', 'updatedAt'])
          && request.resource.data.initialized == true
          && request.resource.data.memberDeviceCount is int
          && request.resource.data.memberDeviceCount >= 1
          && request.resource.data.updatedAt == request.time
        )
        || (
          signedIn()
          && resource.data.initialized == false
          && resource.data.memberDeviceCount == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['initialized', 'memberDeviceCount', 'createdAt', 'updatedAt'])
          && request.resource.data.initialized == true
          && request.resource.data.memberDeviceCount == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if memberDevice() || (signedIn() && deviceId == currentUid());

        allow create: if validDevice(request.resource.data)
          && (memberDevice()
            || (signedIn()
              && deviceId == currentUid()
              && request.resource.data.role == 'member'
              && request.resource.data.active == true
              && getAfter(configPath()).data.initialized == true
              && getAfter(configPath()).data.memberDeviceCount == 1));

        allow update: if memberDevice() && validDevice(request.resource.data);
        allow delete: if memberDevice() && deviceId != currentUid();
      }

      match /requests/{requestId} {
        allow read: if memberDevice() || (signedIn() && requestId == currentUid());
        allow create: if signedIn() && requestId == currentUid() && validRequest(request.resource.data);
        allow update: if memberDevice();
        allow delete: if memberDevice() || (signedIn() && requestId == currentUid());
      }

      match /audit/{auditId} {
        allow read: if memberDevice();
        allow create: if signedIn() && validAudit(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    match /event-data/{eventId} {
      allow read: if memberDevice();
      allow create, update: if memberDevice();
      allow delete: if memberDevice();

      match /tickets/{ticketId} {
        allow read: if memberDevice();
        allow create, update: if memberDevice();
        allow delete: if memberDevice();
      }

      match /members/{memberId} {
        allow read: if memberDevice();
        allow create: if memberDevice() && validReceptionMemberCreate(memberId);
        allow update: if memberDevice() && validReceptionMemberUpdate(memberId);
        allow delete: if memberDevice();
      }

      match /scanner-activity/{activityId} {
        allow read: if memberDevice();
        allow create: if memberDevice() && validScannerActivity(activityId);
        allow update, delete: if false;
      }

      match /analytics/{summaryId} {
        allow read: if memberDevice();
        allow create, update: if memberDevice() && validAnalyticsSummary(summaryId);
        allow delete: if memberDevice();
      }

      match /reception-devices/{deviceId} {
        allow read: if memberDevice();
        allow create: if memberDevice() && validReceptionPresence(deviceId);
        allow update: if memberDevice() && ownsReceptionPresence(eventId, deviceId) && validReceptionPresence(deviceId);
        allow delete: if memberDevice() && ownsReceptionPresence(eventId, deviceId);
      }

      match /reception-devices/{deviceId}/remote-commands/{commandId} {
        allow read: if memberDevice() && (currentUid() == get(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId)).data.registeredDeviceId || currentUid() == resource.data.issuedByUid);
        allow create: if memberDevice() && currentUid() == get(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId)).data.registeredDeviceId && validRemoteCommandCreate(request.resource.data);
        allow update: if memberDevice() && currentUid() == get(/databases/$(database)/documents/event-data/$(eventId)/reception-devices/$(deviceId)).data.registeredDeviceId && validRemoteCommandUpdate(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
