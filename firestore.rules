rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 以前の許可ユーザー一覧はアプリから読み書きさせません。
    match /authorized-users/{userId} {
      allow read, write: if false;
    }

    // アプリが使用するデータだけを、自動認証済みの端末へ開放します。
    match /events/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /system/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /event-data/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /member-cards/{document=**} {
      allow read, write: if isSignedIn();
    }

    // 上記以外のコレクションは常に拒否します。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
