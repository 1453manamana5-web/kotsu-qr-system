rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function devicePath(uid) {
      return /databases/$(database)/documents/system/device-access/devices/$(uid);
    }

    function configPath() {
      return /databases/$(database)/documents/system/device-access;
    }

    function currentDeviceExists() {
      return signedIn() && exists(devicePath(currentUid()));
    }

    function currentDevice() {
      return get(devicePath(currentUid())).data;
    }

    function activeDevice() {
      return currentDeviceExists() && currentDevice().active == true;
    }

    function memberDevice() {
      return activeDevice() && currentDevice().role == 'member';
    }

    function receptionDevice() {
      return activeDevice() && currentDevice().role == 'reception';
    }

    function controlDevice() {
      return activeDevice() && currentDevice().role == 'control';
    }

    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    function validRole(value) {
      return value == 'member'
        || value == 'reception'
        || value == 'control';
    }

    function validRequestType(value) {
      return value == 'initial' || value == 'upgrade';
    }

    function validDeviceType(value) {
      return value in [
        'ipad', 'iphone', 'android', 'windows', 'mac', 'other', 'unknown'
      ];
    }

    function validDevice(data) {
      return data.keys().hasAll([
          'role', 'displayName', 'deviceName', 'active', 'createdAt',
          'approvedAt', 'approvedByUid', 'approvedByName'
        ])
        && data.keys().hasOnly([
          'role', 'displayName', 'deviceName', 'deviceType', 'active', 'createdAt',
          'approvedAt', 'approvedByUid', 'approvedByName', 'disabledAt',
          'disabledByUid', 'disabledByName'
        ])
        && validRole(data.role)
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && (!('deviceType' in data) || validDeviceType(data.deviceType))
        && data.active is bool
        && data.createdAt is timestamp
        && data.approvedAt is timestamp
        && data.approvedByUid is string
        && data.approvedByName is string
        && (!('disabledAt' in data) || data.disabledAt is timestamp)
        && (!('disabledByUid' in data) || data.disabledByUid is string)
        && (!('disabledByName' in data) || data.disabledByName is string);
    }

    function validPendingRequest(data, uid) {
      return signedIn()
        && uid == currentUid()
        && data.keys().hasOnly([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid',
          'decidedByName'
        ])
        && data.keys().hasAll([
          'requestType', 'requestedRole', 'displayName', 'deviceName', 'deviceType',
          'status', 'requestedAt', 'decidedAt', 'decidedByUid',
          'decidedByName'
        ])
        && validRequestType(data.requestType)
        && validRole(data.requestedRole)
        && shortText(data.displayName)
        && shortText(data.deviceName)
        && validDeviceType(data.deviceType)
        && data.status == 'pending'
        && data.requestedAt == request.time
        && data.decidedAt == null
        && data.decidedByUid == ''
        && data.decidedByName == ''
        && (
          (
            data.requestType == 'initial'
            && (!currentDeviceExists() || currentDevice().active != true)
          )
          ||
          (
            data.requestType == 'upgrade'
            && receptionDevice()
            && data.requestedRole == 'member'
          )
        );
    }

    function validDecision(data) {
      return resource.data.status == 'pending'
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decidedAt', 'decidedByUid', 'decidedByName'
        ])
        && (data.status == 'approved' || data.status == 'rejected')
        && data.decidedAt == request.time
        && data.decidedByUid == currentUid()
        && data.decidedByName == currentDevice().displayName;
    }

    function validAudit(data) {
      return data.keys().hasOnly([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.keys().hasAll([
          'action', 'actorUid', 'actorName', 'targetUid', 'targetName',
          'role', 'createdAt'
        ])
        && data.action in [
          'bootstrap-member', 'request-created', 'request-approved',
          'request-rejected', 'device-disabled', 'device-renamed',
          'device-deleted'
        ]
        && data.actorUid is string
        && shortText(data.actorName)
        && data.targetUid is string
        && shortText(data.targetName)
        && (data.role == null || validRole(data.role))
        && data.createdAt == request.time;
    }

    function validReceptionStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastReceptionAt', 'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberCreate(memberId) {
      return request.resource.data.keys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionMemberUpdate(memberId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qrNumber', 'name', 'status', 'lastReceptionAt',
          'lastReceptionOperationId', 'updatedAt'
        ])
        && request.resource.data.qrNumber == memberId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.lastReceptionAt is string
        && request.resource.data.lastReceptionOperationId is string
        && request.resource.data.updatedAt == request.time;
    }

    function validScannerActivity(activityId) {
      return request.resource.data.keys().hasOnly([
          'id', 'type', 'qrNumber', 'timestamp', 'isReEntry', 'source',
          'offline', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'type', 'qrNumber', 'timestamp', 'source', 'createdAt'
        ])
        && request.resource.data.id == activityId
        && request.resource.data.type in [
          'ticket-entry', 'ticket-exit', 'member-entry', 'member-exit'
        ]
        && request.resource.data.qrNumber is string
        && request.resource.data.timestamp is string
        && request.resource.data.source == 'scanner'
        && (!('isReEntry' in request.resource.data)
          || request.resource.data.isReEntry is bool)
        && (!('offline' in request.resource.data)
          || request.resource.data.offline is bool)
        && request.resource.data.createdAt == request.time;
    }

    function validAnalyticsSummary(summaryId) {
      return summaryId == 'summary'
        && request.resource.data.schemaVersion == 2
        && (request.resource.data.revision is int
          || request.resource.data.revision is float)
        && request.resource.data.revision >= 0
        && request.resource.data.needsRebuild is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionPresence(deviceId) {
      return request.resource.data.keys().hasOnly([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'screen', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'deviceId', 'registeredDeviceId', 'deviceName', 'deviceType',
          'role', 'mode', 'appVersion', 'lastSeenAt', 'lastSuccessfulSyncAt',
          'pendingCount', 'cameraState', 'screen', 'sessionStartedAt',
          'lastScanAt', 'updatedAt'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.registeredDeviceId == currentUid()
        && request.resource.data.deviceName == currentDevice().deviceName
        && (
          !('deviceType' in currentDevice())
          || request.resource.data.deviceType == currentDevice().deviceType
        )
        && request.resource.data.role == currentDevice().role
        && request.resource.data.mode in ['entry', 'exit']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() > 0
        && request.resource.data.appVersion.size() <= 20
        && (request.resource.data.lastSeenAt is int
          || request.resource.data.lastSeenAt is float)
        && request.resource.data.lastSuccessfulSyncAt == request.time
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 0
        && request.resource.data.cameraState in ['starting', 'ready', 'error']
        && request.resource.data.screen in ['entry-reception', 'exit-reception']
        && request.resource.data.sessionStartedAt is string
        && request.resource.data.sessionStartedAt.size() <= 60
        && request.resource.data.lastScanAt is string
        && request.resource.data.lastScanAt.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    match /authorized-users/{document=**} {
      allow read, write: if false;
    }

    match /system/device-access {
      allow read: if signedIn();

      // 新規環境で最初の部員端末を登録するときだけ作成できます。
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'initialized', 'memberDeviceCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.initialized == true
        && request.resource.data.memberDeviceCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if memberDevice()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberDeviceCount', 'updatedAt'
        ])
        && request.resource.data.initialized == true
        && request.resource.data.memberDeviceCount is int
        && request.resource.data.memberDeviceCount >= 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if memberDevice() || (signedIn() && deviceId == currentUid());

        allow create: if validDevice(request.resource.data)
          && (
            memberDevice()
            || (
              signedIn()
              && deviceId == currentUid()
              && request.resource.data.role == 'member'
              && request.resource.data.active == true
              && !exists(configPath())
              && getAfter(configPath()).data.initialized == true
              && getAfter(configPath()).data.memberDeviceCount == 1
            )
          );

        allow update: if validDevice(request.resource.data)
          && (
            (
              activeDevice()
              && deviceId == currentUid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'deviceType'
              ])
              && validDeviceType(request.resource.data.deviceType)
            )
            ||
            (
              memberDevice()
              &&
              deviceId == currentUid()
              &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'deviceName'
              ])
              && shortText(request.resource.data.deviceName)
            )
            || (
              memberDevice()
              &&
              deviceId != currentUid()
              && request.resource.data.active == true
            )
          );

        allow delete: if memberDevice()
          && deviceId != currentUid()
          && (
            resource.data.role != 'member'
            || resource.data.active != true
            || (
              getAfter(configPath()).data.memberDeviceCount
                == get(configPath()).data.memberDeviceCount - 1
              && getAfter(configPath()).data.memberDeviceCount >= 1
            )
          );
      }

      match /requests/{requestUid} {
        allow read: if memberDevice() || (signedIn() && requestUid == currentUid());
        allow create: if validPendingRequest(request.resource.data, requestUid);
        allow update: if validPendingRequest(request.resource.data, requestUid)
          || (memberDevice() && requestUid != currentUid() && validDecision(request.resource.data));
        allow delete: if false;
      }

      match /audit/{auditId} {
        allow read: if memberDevice();
        allow create: if validAudit(request.resource.data)
          && (
            memberDevice()
            || (
              signedIn()
              && request.resource.data.action == 'request-created'
              && request.resource.data.actorUid == currentUid()
              && request.resource.data.targetUid == currentUid()
            )
            || (
              signedIn()
              && request.resource.data.action == 'bootstrap-member'
              && request.resource.data.actorUid == currentUid()
              && request.resource.data.targetUid == currentUid()
              && !exists(configPath())
              && getAfter(configPath()).data.initialized == true
            )
          );
        allow update, delete: if false;
      }
    }

    match /system/{systemDocument} {
      allow read: if memberDevice()
        || (activeDevice() && systemDocument == 'current-event');
      allow create, update, delete: if memberDevice()
        && systemDocument != 'device-access';
    }

    match /events/{eventId} {
      allow read: if activeDevice();
      allow create, update, delete: if memberDevice();
    }

    match /member-cards/{memberId} {
      allow read: if memberDevice() || receptionDevice();
      allow create, update, delete: if memberDevice();
    }

    match /event-data/{eventId} {
      allow read, create, update, delete: if memberDevice();

      match /tickets/{ticketId} {
        allow read: if memberDevice() || receptionDevice();
        allow create, delete: if memberDevice();
        allow update: if memberDevice()
          || (receptionDevice() && validReceptionStatusUpdate());
      }

      match /members/{memberId} {
        allow read: if memberDevice() || receptionDevice();
        allow create: if memberDevice()
          || (receptionDevice() && validReceptionMemberCreate(memberId));
        allow update: if memberDevice()
          || (receptionDevice() && validReceptionMemberUpdate(memberId));
        allow delete: if memberDevice();
      }

      match /activity/{activityId} {
        allow read: if memberDevice() || receptionDevice();
        allow create: if memberDevice()
          || (receptionDevice() && validScannerActivity(activityId));
        allow update, delete: if memberDevice();
      }

      match /analytics/{summaryId} {
        allow read: if activeDevice();
        allow create, update: if memberDevice()
          || (receptionDevice() && validAnalyticsSummary(summaryId));
        allow delete: if memberDevice();
      }

      match /reception-devices/{deviceId} {
        allow read: if activeDevice();
        allow create, update: if (memberDevice() || receptionDevice())
          && validReceptionPresence(deviceId);
        allow delete: if memberDevice() || receptionDevice();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
